{
  // The library logs an expected denial (bad signature, unknown root, unauthorized signer, revoked,
  // stale proof, ...) at Debug, not Warning: a hostile client can trigger every one of them at will,
  // so logging them louder would let it flood the log. Raising "ZcapLd" to Debug here is how you see
  // why a request got 403 while developing. Infrastructure faults (CouldNotVerify) log at Warning.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ZcapLd": "Debug"
    }
  }
}
